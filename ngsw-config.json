{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",

  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/**"
        ]
      }
    }
  ],

  "dataGroups": [
    {
      "name": "product-api",
      "urls": [
        "/api/products_billing",
        "/api/category_billing"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "image-cache",
      "urls": [
        "https://kovais-brew-cafe-assets.s3.ap-south-1.amazonaws.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 300,
        "maxAge": "30d"
      }
    }
  ],

  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/assets/**",
    "!/media/**"
  ]
}
